# ─── Database ────────────────────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/hughvest?sslmode=require"

# ─── Auth / Security ─────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key"

# Set to your production domain on Vercel, e.g. https://yourapp.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY="re_..."
